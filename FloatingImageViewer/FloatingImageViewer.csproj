<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>ico\叶黎的浮图查看器.ico</ApplicationIcon>
    <AssemblyName>FloatingImageViewer</AssemblyName>
    <RootNamespace>FloatingImageViewer</RootNamespace>
    <Version>2.2.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors>YeLee</Authors>
    <Description>无边框置顶浮窗看图器</Description>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- 冒烟测试项目位于独立目录，明确排除以免被默认编译收录。 -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <Page Remove="tests\**" />
    <Resource Remove="tests\**" />
    <None Remove="tests\**" />
    <Content Remove="tests\**" />
  </ItemGroup>

  <!-- WinForms 仅为色盘（ColorDialog）使用：移除其全局 using，避免与 WPF 类型歧义。 -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <!-- 应用图标：作为嵌入资源，供托盘图标加载。 -->
  <ItemGroup>
    <Resource Include="ico\叶黎的浮图查看器.ico" />
  </ItemGroup>

</Project>
